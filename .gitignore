# ── Build output ─────────────────────────────────────────────────────────────
/build
app/build
**/build/

# ── Gradle ───────────────────────────────────────────────────────────────────
.gradle
gradle-wrapper.jar
local.properties          # Contains SDK path — never commit
!gradle-wrapper.properties

# ── Android Studio ───────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# ── SECURITY — never commit these ────────────────────────────────────────────
*.jks                     # Release keystore — treat like a password
*.keystore                # Same
keystore.properties       # File that points to your keystore
signing.properties
google-services.json      # If you add Firebase later
release/                  # Common folder name for signing configs

# ── Generated ─────────────────────────────────────────────────────────────────
app/src/main/assets/
*.apk
*.aab
*.ap_
*.dex

# ── OS ────────────────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
.Spotlight-V100
.Trashes

# ── Room schema export (optional — some teams commit this) ───────────────────
# app/schemas/     ← uncomment this line to ignore schema exports
