<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected state: highlight with primary container -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_container" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/primary" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/outline_variant" />
        </shape>
    </item>

</selector>