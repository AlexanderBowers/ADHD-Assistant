    <!-- Page 1 - Welcome -->
    <string name="onboarding_welcome_title">For people with\nhonest intentions</string>
    <string name="onboarding_welcome_body">You opened your phone to Google something.\nNext thing you know, it\'s been an hour.\n\nADHD Assistant gently checks in when you\'ve been on an app longer than you planned.\n\nNo alarms. No judgment. Just a friendly tap on the shoulder.</string>
    <string name="onboarding_privacy_note">&#x1F512; Your data never leaves your phone.\nNo ads. No server. Just you.</string>

    <!-- Page 2 - Usage Access -->
    <string name="onboarding_usage_title">One permission needed</string>
    <string name="onboarding_usage_body">To know which app you\'re in, I need Usage Access. This is a special Android permission &#8212; there\'s no pop-up dialog. You\'ll need to flip a toggle in your system settings.</string>
    <string name="onboarding_usage_steps">1. Tap &#8220;Set up access&#8221; below\n2. Find &#8220;ADHD Assistant&#8221; in the list\n3. Tap it and turn on &#8220;Permit usage access&#8221;\n4. Come back here &#8212; I\'ll continue automatically</string>

    <!-- Page 3 - Location (optional) -->
    <string name="onboarding_location_title">Home detection</string>
    <string name="onboarding_location_body">If you tell me where home is, I can automatically pause check-ins when you\'re out and resume when you\'re back.\n\nThis is completely optional &#8212; the app works perfectly without it.</string>
    <string name="onboarding_location_privacy">Your location is only used to detect when you\'re home. It\'s never stored, shared, or sent anywhere.</string>

    <!-- Page 4 - Pick a routine -->
    <string name="onboarding_routine_title">Pick a starting point</string>
