    <color name="primary_container">#FFE4C0</color>
    <color name="on_primary_container">#2C1200</color>
    <color name="primary_dark">#C07028</color>

    <!-- Secondary: soft sage green — used for completion / positive moments -->
    <color name="secondary">#4EA878</color>
    <color name="on_secondary">#FFFFFF</color>
    <color name="secondary_container">#DFFAED</color>
