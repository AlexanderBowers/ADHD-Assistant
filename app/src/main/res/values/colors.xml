    <color name="error">#C0533A</color>
    <color name="on_error">#FFFFFF</color>
    <color name="error_container">#FFE0D8</color>

    <!-- Alert screen: sunrise gradient endpoints -->
    <color name="alert_gradient_top">#FFF8EE</color>
    <color name="alert_gradient_mid">#FFE8C0</color>
    <color name="alert_gradient_bot">#FFD8A0</color>

    <!-- Grounding / completion screen: warm green -->
    <color name="grounding_bg">#F0FBF4</color>

    <!-- Chip backgrounds -->
    <color name="chip_bg">#FFF3E4</color>
    <color name="chip_bg_selected">#FFE0B0</color>
    <color name="chip_border_selected">#D4823A</color>

    <!-- Night mode overrides in res/values-night/colors.xml:
         surface → #1E1408  (warm dark, not cold grey)
         background → #181008
         primary → #FFB870  (lighter amber on dark)
         on_surface → #F5E8D0
