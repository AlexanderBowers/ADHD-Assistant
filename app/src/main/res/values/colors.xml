    <!-- Backgrounds: warm cream — not white, not sterile -->
    <color name="background">#FFFBF3</color>
    <color name="surface">#FFFDF8</color>
    <color name="surface_variant">#F5EAD8</color>
    <color name="surface_container">#FFF4E4</color>

